## pub(crate) mod focus_core::map

pub(crate) trait MapKey: Copy + Debug {
    fn index(self) -> usize;
    fn from_index(index: usize) -> Self;
}

impl MapKey for BufferId

impl MapKey for EditorId

impl MapKey for PageId

impl MapKey for WindowId

pub(crate) struct Map<K, V> {
    /* private fields */
}

impl<K, V> Default for Map<K, V>

impl<K, V> Map<K, V> {
    pub(crate) fn new() -> Self;
    pub(crate) fn len(&self) -> usize;
    pub(crate) fn values(&self) -> impl Iterator<Item = &V> + '_;
}

impl<K: MapKey, V> Map<K, V> {
    pub(crate) fn keys(&self) -> impl Iterator<Item = K> + '_;
    pub(crate) fn iter(&self) -> impl Iterator<Item = (K, &V)> + '_;
    pub(crate) fn insert(&mut self, key: K, value: V);
}

impl<K: MapKey, V> Index<K> for Map<K, V>

impl<K: MapKey, V> IndexMut<K> for Map<K, V>


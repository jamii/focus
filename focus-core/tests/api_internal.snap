    pub(crate) fn focused_editor(self, app: &App) -> EditorId;
    pub(crate) fn editor_for_buffer(
        self,
        app: &App,
        buffer_id: BufferId,
    ) -> Option<EditorId>;
    pub(crate) fn current_location(self, app: &App) -> Option<(PathBuf, usize)>;
}


## pub mod focus::vcs

pub struct Vcs {
    /* private fields */
}

pub struct Poll {
    pub change: Result<VcsChange, String>,
    pub statuses: HashMap<PathBuf, VcsFileStatus>,
}

impl Vcs {
    pub fn new() -> Vcs;
    pub fn change(
        &self,
        root: &Path,
        revision: &VcsRevisionId,
    ) -> std::io::Result<VcsChange>;
    pub fn file_status(&self, root: &Path, path: &Path) -> Option<VcsFileStatus>;
    pub fn revisions(&self, root: &Path) -> std::io::Result<Vec<VcsRevision>>;
    pub fn checkout(
        &self,
        root: &Path,
        revision: &VcsRevisionId,
    ) -> Option<std::io::Result<()>>;
}

impl Drop for Vcs

pub struct Poller {
    /* private fields */
}

impl Poller {
    pub fn new() -> Poller;
    pub fn poll(&mut self, root: &Path) -> Poll;
    pub fn revisions(&mut self, root: &Path) -> Result<Vec<VcsRevision>, String>;
    pub fn change(
        &mut self,
        root: &Path,
        change_id: &BStr,
    ) -> Result<VcsChange, String>;
    pub fn checkout(
        &mut self,
        root: &Path,
        revision: &VcsRevisionId,
    ) -> Result<(), String>;
}

## crate focus_core

#[macro_export]
macro_rules! log { /* ... */ }

## pub mod focus_core::app

pub struct App {
    pub windows: Windows,
    pub pages: Pages,
    pub editors: Editors,
    pub buffers: Buffers,
    /* private fields */
}

#[derive(Clone, Copy, Debug)]
pub struct WindowSize {
    pub width: u32,
    pub height: u32,
}

pub const INITIAL_TITLE: &str = ...;
pub const INITIAL_SIZE: WindowSize = ...;

pub trait IO {
    fn open_window(&mut self, window_id: WindowId, title: String, size: WindowSize);
    fn close_window(&mut self, window_id: WindowId);
    fn set_window_title(&mut self, window_id: WindowId, title: String);
    fn request_redraw(&mut self, window_id: WindowId);
    fn rebuild_atlas(&mut self, font_size: f32) -> [u32; 2];
    fn get_clipboard_text(&mut self) -> Option<BString>;
    fn set_clipboard_text(&mut self, text: BString);
    fn log(&mut self, message: std::fmt::Arguments<'_>);
    fn exit(&mut self);
    fn file_mtime(&mut self, path: &Path) -> std::io::Result<SystemTime>;
    fn file_read(&mut self, path: &Path) -> std::io::Result<Vec<u8>>;
    fn file_write(
        &mut self,
        path: &Path,
        contents: &[u8],
        create: bool,
    ) -> std::io::Result<SystemTime>;
    fn file_read_at(
        &mut self,
        path: &Path,
        offset: usize,
        limit: usize,
    ) -> std::io::Result<Vec<u8>>;
    fn file_create(&mut self, path: &Path) -> std::io::Result<()>;
    fn local_date(&mut self) -> Date;
    fn home_dir(&mut self) -> PathBuf;
    fn canonical_path(&mut self, path: &Path) -> PathBuf;
    fn dir_list(&mut self, path: &Path) -> std::io::Result<Vec<DirEntry>>;
    fn repo_files(&mut self, dir: &Path) -> std::io::Result<RepoFiles>;
    fn repo_search(
        &mut self,
        dir: &Path,
        pattern: &BStr,
        match_limit: usize,
        line_limit: usize,
    ) -> std::io::Result<RepoSearch>;
    fn repo_root(&mut self, dir: &Path) -> PathBuf;
    fn vcs_change(
        &mut self,
        dir: &Path,
        revision: &VcsRevisionId,
    ) -> std::io::Result<VcsChange>;
    fn vcs_revisions(&mut self, dir: &Path) -> std::io::Result<Vec<VcsRevision>>;
    fn vcs_checkout(
        &mut self,
        dir: &Path,
        revision: &VcsRevisionId,
    ) -> Option<std::io::Result<()>>;
    fn vcs_file_status(&mut self, path: &Path) -> Option<VcsFileStatus>;
    fn process_spawn(&mut self, dir: &Path, command: &BStr, args: &[&BStr]) -> ProcessId;
    fn process_poll(&mut self, id: ProcessId) -> ProcessPoll;
    fn process_kill(&mut self, id: ProcessId);
    fn process_spawn_detached(&mut self, dir: &Path, command: &BStr, args: &[&BStr]);
    fn process_run(
        &mut self,
        dir: &Path,
        command: &BStr,
        args: &[&BStr],
        stdin: &BStr,
    ) -> std::io::Result<Vec<u8>>;
}

#[derive(PartialEq, Eq, Clone, Copy, Debug)]
pub struct ProcessId(pub usize);

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ProcessPoll {
    pub new_output: Vec<u8>,
    pub exit_code: Option<i32>,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct DirEntry {
    pub name: OsString,
    pub is_dir: bool,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct RepoFiles {
    pub root: PathBuf,
    pub relative_paths: Vec<PathBuf>,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct RepoSearch {
    pub root: PathBuf,
    pub matches: Vec<RepoMatch>,
    pub truncated: bool,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct RepoMatch {
    pub relative_path: PathBuf,
    pub line: usize,
    pub range: Range<usize>,
    pub line_text: BString,
}

#[derive(Clone, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub enum VcsRevisionId {
    WorkingCopy,
    Change(BString),
}

impl VcsRevisionId {
    pub fn name(&self) -> BString;
}

pub const ID_PREFIX_LEN: usize = ...;

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct VcsRevision {
    pub change_id: BString,
    pub commit_id: BString,
    pub author: BString,
    pub description: BString,
    pub is_working_copy: bool,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct VcsChange {
    pub root: PathBuf,
    pub change_id: BString,
    pub commit_id: BString,
    pub author: BString,
    pub description: BString,
    pub files: Vec<VcsFile>,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct VcsFile {
    pub relative_path: PathBuf,
    pub kind: VcsFileKind,
    pub binary: bool,
    pub hunks: Vec<VcsHunk>,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum VcsFileKind {
    Added,
    Deleted,
    Modified,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct VcsHunk {
    pub old_lines: Range<usize>,
    pub new_lines: Range<usize>,
    pub lines: Vec<VcsLine>,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct VcsLine {
    pub kind: VcsLineKind,
    pub text: BString,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum VcsLineKind {
    Context,
    Removed,
    Added,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct VcsFileStatus {
    pub ranges: Vec<VcsLineRange>,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct VcsLineRange {
    pub lines: Range<usize>,
    pub kind: VcsChangeKind,
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum VcsChangeKind {
    Added,
    Modified,
    Deleted,
}

impl App {
    pub fn assert_invariants(&self);
    pub fn new(io: &mut dyn IO) -> App;
    pub fn tick(&mut self, io: &mut dyn IO, frame_start: Duration);
    pub fn input(
        &mut self,
        io: &mut dyn IO,
        window_id: WindowId,
        event: InputEvent<'_>,
    );
    pub fn draw(&mut self, window_id: WindowId, drawing: &mut Drawing);
    pub fn cell_size(&self) -> [u32; 2];
}


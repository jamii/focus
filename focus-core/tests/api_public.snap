## pub mod focus_core::fuzz

pub struct MockIO {
    pub open_windows: Vec<WindowId>,
    pub exited: bool,
    pub screen_size: [f32; 2],
    pub frame_start: Duration,
    pub mouse_position: [f32; 2],
    pub clipboard: Option<BString>,
    pub logs: Vec<String>,
    pub files: HashMap<PathBuf, (Vec<u8>, SystemTime)>,
    pub repo_roots: Vec<PathBuf>,
    pub vcs_changes: HashMap<(PathBuf, VcsRevisionId), VcsChange>,
    pub vcs_statuses: HashMap<PathBuf, VcsFileStatus>,
    pub vcs_revisions: HashMap<PathBuf, Vec<VcsRevision>>,
    pub vcs_checkouts: Vec<(PathBuf, VcsRevisionId)>,
    pub vcs_checkout_pending: bool,
    pub vcs_checkout_error: Option<String>,
    pub system_time: SystemTime,
    pub local_date: Date,
    pub next_process_output: Vec<u8>,
    pub next_process_exit_code: Option<i32>,
    pub processes: Vec<MockProcess>,
    pub process_run_outputs: BTreeMap<BString, Vec<u8>>,
    pub process_runs: Vec<ProcessRun>,
    pub detached: Vec<DetachedProcess>,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ProcessRun {
    pub dir: PathBuf,
    pub command: BString,
    pub args: Vec<BString>,
    pub stdin: BString,
}

pub struct MockProcess {
    pub dir: PathBuf,
    pub command: BString,
    pub args: Vec<BString>,
    pub pending_output: Vec<u8>,
    pub exit_code: Option<i32>,
    pub killed: bool,
}

pub struct DetachedProcess {
    pub dir: PathBuf,
    pub command: BString,
    pub args: Vec<BString>,
}

impl MockIO {
    pub fn new() -> Self;
}

impl IO for MockIO


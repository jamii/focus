}

pub struct Atlas {
    pub size: [u32; 2],
    pub pixels: Vec<u8>,
    pub glyphs: HashMap<char, Glyph>,
    pub notdef: Glyph,
    pub cell_size: [u32; 2],
}

impl Atlas {
    pub fn build(font: &Font, font_size: f32) -> Self;
    pub fn glyph(&self, ch: char) -> Glyph;
}

